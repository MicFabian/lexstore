{
  "realm": "lexstore",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Full control of projects and settings"
      },
      {
        "name": "admin",
        "description": "Manage languages, contributors, API keys"
      },
      {
        "name": "translator",
        "description": "Create and edit translations"
      },
      {
        "name": "proofreader",
        "description": "Review and proofread translations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lexstore-spa",
      "name": "Lexstore SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "__APP_ORIGIN__",
      "baseUrl": "__APP_ORIGIN__",
      "redirectUris": [
        "__APP_ORIGIN__/*"
      ],
      "webOrigins": [
        "__APP_ORIGIN__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__APP_ORIGIN__/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "loginTheme": "lexstore",
  "displayName": "Lexstore",
  "displayNameHtml": "<span>Lex<b>store</b></span>"
}
