{
  "realm": "translad",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Full control of projects and settings"
      },
      {
        "name": "admin",
        "description": "Manage languages, contributors, API keys"
      },
      {
        "name": "translator",
        "description": "Create and edit translations"
      },
      {
        "name": "proofreader",
        "description": "Review and proofread translations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "translad-spa",
      "name": "TransLad SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4300",
      "baseUrl": "http://localhost:4300",
      "redirectUris": [
        "http://localhost:4300/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4300",
        "http://localhost:4200",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/*##http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
