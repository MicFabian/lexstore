# Copy to .env and fill in. Never commit the filled-in file.

# Database
DATABASE_USER=lexstore
DATABASE_PASSWORD=change-me

# Keycloak admin (first boot only) and the issuer the browser and API both use
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER=https://auth.example.com/realms/lexstore

# Browser origins allowed to call the API, comma-separated
ALLOWED_ORIGINS=https://lexstore.example.com

# Optional machine-translation providers; the mock is used when unset
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Published ports
WEB_PORT=8080
KEYCLOAK_PORT=8089

# Encrypts provider API keys stored through the UI. Without it, keys cannot be
# saved and translation falls back to the keys given below. Generate one with
# `openssl rand -base64 32` and keep it out of the database's reach.
LEXSTORE_SECRET_KEY=

# The platform's own provider key, used by organisations on an agent plan.
LEXSTORE_AGENT_KEY=

# Fallback provider keys, used when no organisation or project key is stored.
OPENAI_API_KEY=
