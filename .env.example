# Copy to .env and fill in. Never commit the filled-in file.

# Database
DATABASE_USER=translad
DATABASE_PASSWORD=change-me

# Keycloak admin (first boot only) and the issuer the browser and API both use
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER=https://auth.example.com/realms/translad

# Browser origins allowed to call the API, comma-separated
ALLOWED_ORIGINS=https://translad.example.com

# Optional machine-translation providers; the mock is used when unset
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Published ports
WEB_PORT=8080
KEYCLOAK_PORT=8089
